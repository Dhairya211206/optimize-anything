+#ifdef LOTTERY_SCHED
+// ---- feature 2 (Track G): lottery scheduler. Each RUNNABLE process holds `tickets` tickets; every scheduling decision
+// draws a random ticket and runs the owner for one timer slice, so long-run CPU share is proportional to tickets. ----
+static struct spinlock lottery_lock;
+static uint64 lottery_state = 88172645463325252ULL;
+
+static uint64
+lottery_rand(void)
+{
+  acquire(&lottery_lock);
+  uint64 x = lottery_state;
+  x ^= x << 13;
+  x ^= x >> 7;
+  x ^= x << 17;
+  lottery_state = x;
+  release(&lottery_lock);
+  return x;
+}
+
+void
+scheduler(void)
+{
+  struct proc *p;
+  struct cpu *c = mycpu();
+
+  initlock(&lottery_lock, "lottery");
+  c->proc = 0;
+  for (;;) {
+    intr_on();
+    intr_off();
+
+    // pass 1: total tickets held by runnable processes
+    int total = 0;
+    for (p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if (p->state == RUNNABLE)
+        total += p->tickets;
+      release(&p->lock);
+    }
+    if (total == 0) {
+      asm volatile("wfi");
+      continue;
+    }
+    // pass 2: find the owner of the winning ticket (state may have changed; if so just draw again)
+    int winner = (int)(lottery_rand() % (uint64)total), counter = 0;
+    for (p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if (p->state == RUNNABLE) {
+        counter += p->tickets;
+        if (counter > winner) {
+          p->state = RUNNING;
+          c->proc = p;
+          swtch(&c->context, &p->context);
+          mycpu()->intena = 0;
+          c->proc = 0;
+          release(&p->lock);
+          break;
+        }
+      }
+      release(&p->lock);
+    }
+  }
+}
+#else
 void
 scheduler(void)
 {
@@ -468,6 +534,7 @@ scheduler(void)
     }
   }
 }
+#endif
 
