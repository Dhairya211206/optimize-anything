diff --git a/user/forkbench.c b/user/forkbench.c
new file mode 100644
index 0000000..57bfbe5
--- /dev/null
+++ b/user/forkbench.c
@@ -0,0 +1,39 @@
+// [Track G] fork/exit churn: every fork allocates a page table, a trapframe page and copies memory (kalloc/kfree heavy).
+// usage: forkbench <procs> <rounds>
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if (argc != 3) {
+    fprintf(2, "usage: forkbench procs rounds\n");
+    exit(1);
+  }
+  int procs = atoi(argv[1]), rounds = atoi(argv[2]);
+  uint64 t0 = rdtime(), s0 = kmemspins();
+  for (int i = 0; i < procs; i++) {
+    int pid = fork();
+    if (pid < 0) {
+      fprintf(2, "fork failed\n");
+      exit(1);
+    }
+    if (pid == 0) {
+      for (int r = 0; r < rounds; r++) {
+        int c = fork();
+        if (c < 0) exit(1);
+        if (c == 0) exit(0);
+        wait(0);
+      }
+      exit(0);
+    }
+  }
+  int bad = 0, st;
+  for (int i = 0; i < procs; i++) {
+    wait(&st);
+    if (st != 0) bad++;
+  }
+  printf("RESULT procs=%d rounds=%d pages=0 ticks=%d spins=%d bad=%d\n", procs, rounds, (int)(rdtime() - t0), (int)(kmemspins() - s0), bad);
+  exit(0);
+}
diff --git a/user/membench.c b/user/membench.c
new file mode 100644
index 0000000..62648af
--- /dev/null
+++ b/user/membench.c
@@ -0,0 +1,45 @@
+// [Track G] allocator contention benchmark.
+// usage: membench <procs> <rounds> <pages>
+// Each of <procs> children runs <rounds> times: grow its heap by <pages> pages, then shrink it again.
+// Growing/shrinking calls kalloc/kfree once per page. Prints elapsed timer ticks (10 MHz) and the number of
+// failed attempts on the physical-allocator lock(s).
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if (argc != 4) {
+    fprintf(2, "usage: membench procs rounds pages\n");
+    exit(1);
+  }
+  int procs = atoi(argv[1]), rounds = atoi(argv[2]), pages = atoi(argv[3]);
+  uint64 t0 = rdtime(), s0 = kmemspins();
+  for (int i = 0; i < procs; i++) {
+    int pid = fork();
+    if (pid < 0) {
+      fprintf(2, "fork failed\n");
+      exit(1);
+    }
+    if (pid == 0) {
+      for (int r = 0; r < rounds; r++) {
+        if (sbrk(pages * 4096) == (char *)-1) {
+          fprintf(2, "sbrk failed\n");
+          exit(1);
+        }
+        sbrk(-pages * 4096);
+      }
+      exit(0);
+    }
+  }
+  int bad = 0, st;
+  for (int i = 0; i < procs; i++) {
+    wait(&st);
+    if (st != 0) bad++;
+  }
+  uint64 t1 = rdtime(), s1 = kmemspins();
+  printf("RESULT procs=%d rounds=%d pages=%d ticks=%d spins=%d bad=%d\n", procs, rounds, pages,
+         (int)(t1 - t0), (int)(s1 - s0), bad);
+  exit(0);
+}
diff --git a/user/memfull.c b/user/memfull.c
new file mode 100644
index 0000000..c779ea2
--- /dev/null
+++ b/user/memfull.c
@@ -0,0 +1,16 @@
+// [Track G] correctness check for the allocator: how many pages can ONE process obtain before sbrk fails?
+// With per-CPU free lists this only equals the baseline if stealing really reaches every CPU's list.
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(void)
+{
+  int n = 0;
+  while (sbrk(4096) != (char *)-1)
+    n++;
+  sbrk(-n * 4096);
+  printf("RESULT pages=%d\n", n);
+  exit(0);
+}
diff --git a/user/pipebench.c b/user/pipebench.c
new file mode 100644
index 0000000..d6badb9
--- /dev/null
+++ b/user/pipebench.c
@@ -0,0 +1,44 @@
+// [Track G] pipe churn: every pipe() allocates a kernel page (kalloc) and every close frees it.
+// usage: pipebench <procs> <rounds>
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if (argc != 3) {
+    fprintf(2, "usage: pipebench procs rounds\n");
+    exit(1);
+  }
+  int procs = atoi(argv[1]), rounds = atoi(argv[2]);
+  uint64 t0 = rdtime(), s0 = kmemspins();
+  for (int i = 0; i < procs; i++) {
+    int pid = fork();
+    if (pid < 0) {
+      fprintf(2, "fork failed\n");
+      exit(1);
+    }
+    if (pid == 0) {
+      char buf[64];
+      for (int r = 0; r < rounds; r++) {
+        int fds[2];
+        if (pipe(fds) < 0) exit(1);
+        memset(buf, r, sizeof(buf));
+        if (write(fds[1], buf, sizeof(buf)) != sizeof(buf)) exit(1);
+        if (read(fds[0], buf, sizeof(buf)) != sizeof(buf)) exit(1);
+        if (buf[0] != (char)r) exit(1);
+        close(fds[0]);
+        close(fds[1]);
+      }
+      exit(0);
+    }
+  }
+  int bad = 0, st;
+  for (int i = 0; i < procs; i++) {
+    wait(&st);
+    if (st != 0) bad++;
+  }
+  printf("RESULT procs=%d rounds=%d pages=0 ticks=%d spins=%d bad=%d\n", procs, rounds, (int)(rdtime() - t0), (int)(kmemspins() - s0), bad);
+  exit(0);
+}
diff --git a/user/schedbench.c b/user/schedbench.c
new file mode 100644
index 0000000..8afc0e3
--- /dev/null
+++ b/user/schedbench.c
@@ -0,0 +1,49 @@
+// [Track G] proportional-share benchmark for the scheduler.
+// usage: schedbench <tickets1> <tickets2> <tickets3> <duration_ticks>
+// Three CPU-bound children each call settickets() and then block on a "go" pipe. Once all three exist, the parent sends every
+// child the same absolute deadline (now + duration timer ticks); each child counts loop iterations until that deadline and
+// reports its count. A child only counts while it is running, so its count is proportional to the CPU time it received.
+// (An earlier version let each child time itself from its own start; the one-ticket parent then forked the children slowly
+// and the last child started late, which biased the shares. The common deadline removes that artefact.)
+// With a lottery scheduler the shares should follow the ticket ratio; with the stock round-robin scheduler they stay near 1/3.
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  if (argc != 5) {
+    fprintf(2, "usage: schedbench t1 t2 t3 duration\n");
+    exit(1);
+  }
+  int dur = atoi(argv[4]);
+  int res[3][2], go[3][2];
+  for (int i = 0; i < 3; i++) {
+    pipe(res[i]);
+    pipe(go[i]);
+    int pid = fork();
+    if (pid == 0) {
+      settickets(atoi(argv[1 + i]));
+      uint deadline;
+      read(go[i][0], &deadline, sizeof(deadline));
+      uint64 count = 0;
+      while (uptime() < deadline)
+        count++;
+      write(res[i][1], &count, sizeof(count));
+      exit(0);
+    }
+  }
+  uint deadline = uptime() + dur;
+  for (int i = 0; i < 3; i++)
+    write(go[i][1], &deadline, sizeof(deadline));
+  uint64 c[3];
+  for (int i = 0; i < 3; i++) {
+    read(res[i][0], &c[i], sizeof(uint64));
+    wait(0);
+  }
+  uint64 tot = c[0] + c[1] + c[2];
+  printf("SHARE %d %d %d permille %d %d %d\n", atoi(argv[1]), atoi(argv[2]), atoi(argv[3]), (int)(c[0] * 1000 / tot),
+         (int)(c[1] * 1000 / tot), (int)(c[2] * 1000 / tot));
+  exit(0);
+}
